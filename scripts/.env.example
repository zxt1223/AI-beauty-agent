# beauty_agent 密钥配置模板
# 复制本文件为 scripts/.env 并填入真实值（.env 已被 .gitignore 挡住，绝不上传）
# 不配置也能运行：LLM 超时 / 断连 / 无 key 一律自动降级回纯规则。

# LLM 兜底（中文输入 / 英文规则盲区）：DeepSeek 开放平台 key
DEEPSEEK_API_KEY=sk-xxx

# 评测链路数据库（默认已指向 127.0.0.1:3306/beauty_agent，按需修改）
# BEAUTY_DB_USER=root
# BEAUTY_DB_PWD=CHANGE_ME
# BEAUTY_DB_HOST=127.0.0.1
# BEAUTY_DB_PORT=3306
# BEAUTY_DB_NAME=beauty_agent
# BEAUTY_DB_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/beauty_agent?charset=utf8mb4
